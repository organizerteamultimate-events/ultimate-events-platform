NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: required for validated private receipt uploads and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional server-side SMTP for transactional email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=ULTIMATE EVENTS <your-gmail-address>
