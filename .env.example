NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UPI_ID=your-business-upi-id

# Required server-side secrets for admin/bootstrap or provider integrations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key

# Server-side Gmail App Password SMTP for registration notices and payment receipts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=ULTIMATE EVENTS <your-gmail-address>
